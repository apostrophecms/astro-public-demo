{
  "name": "public-demo",
  "version": "1.0.0",
  "description": "Apostrophe Public Demo Site",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "dev": "cross-env APOS_EXTERNAL_FRONT_KEY=dev APOS_DEV=1 nodemon",
    "build": "cross-env NODE_ENV=production node app @apostrophecms/asset:build",
    "serve": "cross-env NODE_ENV=production node app",
    "serve:gh": "cross-env NODE_ENV=production APOS_EXTERNAL_FRONT_KEY=dev node app",
    "release": "npm install && npm run build && npm run migrate",
    "migrate": "cross-env NODE_ENV=production node app @apostrophecms/migration:migrate",
    "staging-deploy": "echo \"ℹ️  Clearing module links and installed modules to deploy.\" && rm package-lock.json && rm -r node_modules && npm i && sc-deploy staging",
    "analyze-bundle": "APOS_BUNDLE_ANALYZER=1 node app @apostrophecms/asset:build"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "dependencies": {
    "@apostrophecms/blog": "^1.0.6",
    "@apostrophecms/favicon": "^1.1.3",
    "@apostrophecms/import-export": "^2.6.0",
    "@apostrophecms/open-graph": "^1.2.3",
    "@apostrophecms/seo": "^1.4.0",
    "@apostrophecms/sitemap": "^1.2.0",
    "@apostrophecms/vite": "^1.1.1",
    "apostrophe": "^4.24.1",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.20",
    "klona": "^2.0.6"
  },
  "author": "Apostrophe Technologies, Inc",
  "license": "MIT",
  "nodemonConfig": {
    "verbose": true,
    "watch": [
      "./app.js",
      "./modules/**/*",
      "./lib/**/*.js",
      "./views/**/*.html",
      "./src/**/*",
      "./node_modules/apostrophe/modules/@apostrophecms/**/*"
    ],
    "ignoreRoot": [
      ".git"
    ],
    "ignore": [
      "lib/modules/*/public/js/*.js",
      "locales/*.json",
      "public/uploads",
      "public/apos-frontend",
      "modules/asset/ui/public",
      "data"
    ],
    "ext": "json, js, html, scss, vue"
  },
  "devDependencies": {
    "eslint": "^7.32.0",
    "eslint-config-apostrophe": "^3.4.2",
    "eslint-plugin-node": "^11.1.0",
    "nodemon": "^2.0.22"
  }
}