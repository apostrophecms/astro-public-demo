{
  "name": "astro-frontend",
  "engines": {
    "node": ">=22.22.0"
  },
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "cross-env APOS_EXTERNAL_FRONT_KEY=dev astro dev",
    "start": "astro dev",
    "build": "astro build",
    "build:static": "APOS_BUILD=static APOS_EXTERNAL_FRONT_KEY=dev astro build",
    "build:gh": "APOS_BUILD=static APOS_EXTERNAL_FRONT_KEY=dev astro build",
    "serve": "HOST=0.0.0.0 PORT=4321 node ./dist/server/entry.mjs",
    "preview": "astro preview",
    "preview:static": "APOS_BUILD=static astro preview --port 4000",
    "astro": "astro"
  },
  "dependencies": {
    "@apostrophecms/apostrophe-astro": "^1.17.0",
    "@astrojs/node": "^11.1.8",
    "astro": "^7.4.0",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.23",
    "postcss-viewport-to-container-toggle": "^2.3.0",
    "sass": "^1.105.2",
    "vite": "^8.3.4"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "esbuild": true,
    "fsevents": true,
    "sharp": true
  }
}
