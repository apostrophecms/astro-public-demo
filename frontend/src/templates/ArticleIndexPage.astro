---
import AposArea from "@apostrophecms/apostrophe-astro/components/AposArea.astro";
import { buildPageUrl } from "@apostrophecms/apostrophe-astro/helpers/universal";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ArticleExcerpt from "../components/ArticleExcerpt.astro";
import { getLocale, createTranslator } from "@app/utils/i18n.js";

const aposData = Astro.props.aposData;
const locale = getLocale(aposData);
const __t = createTranslator(locale);
const {
  page,
  pieces = [],
  filters = [],
  currentPage = 1,
  totalPages = 1,
} = aposData;

// Populated by the backend from the `piecesFilters` option in
// backend/modules/article-page/index.js. Each choice carries its own `_url`
// (a path, since @apostrophecms/url has `static: true`) and `active` flag.
const categoryFilter = filters.find((f) => f.name === "categories");
const categoryChoices = categoryFilter?.choices || [];

// A category or an author may be active. Either way, "All Articles" is not.
const hasActiveChoice = filters.some((f) => f.choices?.some((c) => c.active));

// Build a lookup map so ArticleExcerpt can link category chips
// to the correct filter URL.
const categoryUrls = {};
for (const choice of categoryChoices) {
  categoryUrls[choice.value] = choice._url;
}

const pagerOptions = {
  page: currentPage,
  total: totalPages,
  shown: 5,
};

function getPageRange(options) {
  const pages = [];
  const shown = options.shown || 5;
  const half = Math.floor(shown / 2);
  let start = Math.max(2, options.page - half);
  let end = Math.min(options.total - 1, options.page + half);

  if (options.page <= half + 1) {
    end = Math.min(options.total - 1, shown);
  }
  if (options.page >= options.total - half) {
    start = Math.max(2, options.total - shown + 1);
  }

  for (let i = start; i <= end; i++) {
    pages.push(i);
  }
  return pages;
}

const pageRange = getPageRange(pagerOptions);
// Derive the gaps from the range itself so an ellipsis only appears when
// pages are actually skipped (page 4 of 6 previously showed "1 … 2 3 4 5 6").
const showHeadGap = pageRange.length > 0 && pageRange[0] > 2;
const showTailGap =
  pageRange.length > 0 && pageRange[pageRange.length - 1] < totalPages - 1;

function buildUrl(pageNum) {
  return buildPageUrl(aposData, pageNum);
}
---

<Breadcrumbs {page} />

<div class="article-title-wrapper">
  <div class="layout">
    <h1 class="page-title">{page.title}</h1>
    {
      categoryChoices.length > 0 && (
        <ul class="article-topic-filters">
          <li>
            <a
              href={page._url}
              class={!hasActiveChoice ? "active" : ""}
            >
              {__t("allArticles")}
            </a>
          </li>
          {categoryChoices.map((choice) => (
            <li>
              <a href={choice._url} class={choice.active ? "active" : ""}>
                {choice.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</div>

<div class="layout">
  <main>
    <section class="article-index">
      <header class="article-intro general-content">
        <AposArea area={page.intro} locale={locale} />
      </header>

      {/* First two articles with featured/horizontal treatment */}
      <div
        class="article-excerpts article-excerpts--display-horizontal article-excerpts--display-featured"
      >
        {
          pieces
            .slice(0, 2)
            .map((article) => (
              <ArticleExcerpt
                article={article}
                categoryUrls={categoryUrls}
                locale={locale}
              />
            ))
        }
      </div>

      {/* Remaining articles in grid */}
      <div class="article-excerpts article-excerpts--display-grid">
        {
          pieces
            .slice(2)
            .map((article) => (
              <ArticleExcerpt
                article={article}
                categoryUrls={categoryUrls}
                locale={locale}
              />
            ))
        }
      </div>

      {/* Pagination */}
      {
        (currentPage > 1 || totalPages > 1) && (
          <nav class="pager" aria-label={__t("pagination")}>
            <span
              class={`pager__item is-first ${currentPage === 1 ? "is-active" : ""}`}
              aria-current={currentPage === 1 ? "page" : undefined}
            >
              {currentPage !== 1 ? <a href={buildUrl(1)}>1</a> : 1}
            </span>
            {showHeadGap && <span class="pager__gap">&hellip;</span>}
            {pageRange.map((pageNum) => (
              <span
                class={`pager__item ${currentPage === pageNum ? "is-active" : ""}`}
                aria-current={currentPage === pageNum ? "page" : undefined}
              >
                {currentPage !== pageNum ? (
                  <a href={buildUrl(pageNum)}>{pageNum}</a>
                ) : (
                  pageNum
                )}
              </span>
            ))}
            {showTailGap && <span class="pager__gap">&hellip;</span>}
            {totalPages > 1 && (
              <span
                class={`pager__item is-last ${currentPage === totalPages ? "is-active" : ""}`}
                aria-current={currentPage === totalPages ? "page" : undefined}
              >
                {currentPage !== totalPages ? (
                  <a href={buildUrl(totalPages)}>{totalPages}</a>
                ) : (
                  totalPages
                )}
              </span>
            )}
          </nav>
        )
      }
    </section>
  </main>
</div>
